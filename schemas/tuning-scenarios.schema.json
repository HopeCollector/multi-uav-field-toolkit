{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/multi-uav-field-toolkit/tuning-scenarios.schema.json",
  "title": "Synthetic tuning scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "complexity", "narrowness", "length_m"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "complexity": {"type": "number", "minimum": 0, "maximum": 10},
          "narrowness": {"type": "number", "minimum": 0, "maximum": 1},
          "length_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}
        }
      }
    }
  }
}
