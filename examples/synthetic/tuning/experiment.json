{
  "$schema": "../../../schemas/tuning-experiment.schema.json",
  "schema_version": 1,
  "experiment_id": "synthetic-navigation-demo",
  "budget": {
    "rounds": 4,
    "max_candidates_per_round": 12
  },
  "evaluator": {
    "id": "synthetic-planner-v1",
    "timeout_seconds": 10
  },
  "scenarios": "scenarios.json",
  "parameters": {
    "lookahead_m": {
      "type": "float",
      "baseline": 7.0,
      "min": 4.0,
      "max": 10.0,
      "step": 1.0
    },
    "replan_distance_m": {
      "type": "float",
      "baseline": 3.5,
      "min": 2.0,
      "max": 5.0,
      "step": 0.5
    },
    "grid_resolution_m": {
      "type": "float",
      "baseline": 0.15,
      "min": 0.1,
      "max": 0.3,
      "step": 0.05
    },
    "safety_margin_m": {
      "type": "float",
      "baseline": 0.35,
      "min": 0.15,
      "max": 0.6,
      "step": 0.05
    },
    "speed_limit_mps": {
      "type": "float",
      "baseline": 2.0,
      "min": 1.0,
      "max": 3.0,
      "step": 0.25
    },
    "sample_stride": {
      "type": "integer",
      "baseline": 2,
      "min": 1,
      "max": 4,
      "step": 1
    }
  },
  "constraints": [
    {
      "metric": "success_rate",
      "operator": ">=",
      "threshold": 0.85
    },
    {
      "metric": "collision_count",
      "operator": "<=",
      "threshold": 0
    },
    {
      "metric": "p95_replan_ms",
      "operator": "<=",
      "threshold": 70
    },
    {
      "metric": "minimum_clearance_m",
      "operator": ">=",
      "threshold": 0.18
    },
    {
      "metric": "max_command_gap_ms",
      "operator": "<=",
      "threshold": 100
    }
  ],
  "objectives": [
    {
      "metric": "success_rate",
      "direction": "maximize",
      "weight": 4,
      "range": [0.75, 1.0]
    },
    {
      "metric": "p95_replan_ms",
      "direction": "minimize",
      "weight": 3,
      "range": [35, 80]
    },
    {
      "metric": "minimum_clearance_m",
      "direction": "maximize",
      "weight": 2,
      "range": [0.1, 0.5]
    },
    {
      "metric": "completion_time_s",
      "direction": "minimize",
      "weight": 2,
      "range": [250, 750]
    },
    {
      "metric": "path_length_ratio",
      "direction": "minimize",
      "weight": 1,
      "range": [1.0, 1.4]
    }
  ],
  "search": {
    "shrink_factor": 0.5
  }
}
